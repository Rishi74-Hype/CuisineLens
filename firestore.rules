rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Meal logs subcollection
      match /meals/{mealId} {
        allow read, write: if isOwner(userId);
      }

      // Water logs subcollection
      match /waterLogs/{date} {
        allow read, write: if isOwner(userId);
      }
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }
  }
}
